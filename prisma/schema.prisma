generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Client {
  id          Int             @id @default(autoincrement())
  name        String
  contact     String?
  monthlyFee  Int
  dueDay      Int
  sortOrder   Int             @default(0)
  active      Boolean         @default(true)
  deletedAt   DateTime?
  archivedFromCompetence String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  payments    ClientPayment[]

  @@index([deletedAt, sortOrder])
}

model ClientPayment {
  id         Int      @id @default(autoincrement())
  clientId   Int
  competence String
  amount     Int
  note       String?
  paidAt     DateTime @default(now())
  createdAt  DateTime @default(now())
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, competence])
  @@index([competence])
}

model Expense {
  id          Int                 @id @default(autoincrement())
  name        String
  category    String?
  amount      Int
  dueDay      Int
  sortOrder   Int                 @default(0)
  active      Boolean             @default(true)
  deletedAt   DateTime?
  archivedFromCompetence String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  settlements ExpenseSettlement[]

  @@index([deletedAt, sortOrder])
}

model ExpenseSettlement {
  id         Int      @id @default(autoincrement())
  expenseId   Int
  competence String
  note       String?
  paidAt     DateTime @default(now())
  createdAt  DateTime @default(now())
  expense    Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@unique([expenseId, competence])
  @@index([competence])
}
